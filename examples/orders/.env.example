# Copy to .env and source it, or pass these through your process manager.
# The service reads configuration from the environment (see config.go).

# Required: Postgres connection string.
DB_CONN_STR=postgres://orders:orders@localhost:5432/orders?sslmode=disable

# Optional: Redis (defaults shown).
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Optional: HTTP listen address (default shown).
HTTP_ADDR=:8080
